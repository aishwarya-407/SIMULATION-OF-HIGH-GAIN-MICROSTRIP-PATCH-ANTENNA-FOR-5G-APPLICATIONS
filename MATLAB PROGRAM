%% Input Parameters
f = 28e9;          % Frequency = 28 GHz
c = 3e8;           % Speed of light (m/s)
er = 2.2;          % Relative permittivity
h = 0.2e-3;        % Substrate height = 0.2 mm
%% Patch Width (W)
W = (c/(2*f))*sqrt(2/(er+1));
%% Effective Dielectric Constant
ereff = (er+1)/2 + (er-1)/2 * (1 + 12*h/W)^(-0.5);
%% Effective Patch Length
Leff = c/(2*f*sqrt(ereff));
%% Length Extension due to Fringing
deltaL = 0.412*h * ...
    ((ereff+0.3)*(W/h+0.264)) / ...
    ((ereff-0.258)*(W/h+0.8));
%% Actual Patch Length
L = Leff - 2*deltaL;
%% Substrate Dimensions
Ls = L + 6*h;
Ws = W + 6*h;
%% 50 Ohm Microstrip Feed-Line Width
Z0 = 50;
A = (Z0/60)*sqrt((er+1)/2) + ...
    ((er-1)/(er+1))*(0.23 + 0.11/er);
Wf_h = (8*exp(A))/(exp(2*A)-2);
Wf = Wf_h*h;
%% Convert to mm
fprintf('Patch Width (W)       = %.4f mm\n', W*1000);
fprintf('Patch Length (L)      = %.4f mm\n', L*1000);
fprintf('Substrate Width (Ws)  = %.4f mm\n', Ws*1000);
fprintf('Substrate Length (Ls) = %.4f mm\n', Ls*1000);
fprintf('Feed Width (Wf)       = %.4f mm\n', Wf*1000);
fprintf('Effective Er          = %.4f\n', ereff);
